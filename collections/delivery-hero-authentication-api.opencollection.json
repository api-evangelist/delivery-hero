{
  "opencollection": "1.0.0",
  "info": {
    "name": "On Demand Rider Authentication API",
    "version": "1.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request OAuth Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pandago-api-sandbox.deliveryhero.io/sg/api/v1/oauth2/token"
          },
          "docs": "Authentication"
        }
      ]
    }
  ],
  "bundled": true
}